{
    "compilerOptions": {
        "types": ["jquery"],
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["DOM", "DOM.Iterable", "ES2022"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true
    },
    "include": ["**/*.ts"],
    "typeAcquisition": {
        "enable": true,
        "include": ["jquery"]
    }
}
